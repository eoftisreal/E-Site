NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=noreply@indiemart.dev
EMAIL_FROM_AUTH=auth@indiemart.dev
EMAIL_FROM_ORDERS=orders@indiemart.dev
EMAIL_FROM_SUPPORT=support@indiemart.dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ENABLE_HTTP_LOGS=false
MONGO_MAX_POOL_SIZE=5
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=20000
REQUEST_TIMEOUT_MS=30000
